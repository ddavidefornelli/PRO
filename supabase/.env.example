# Copy to supabase/.env.local (gitignored). Never commit real credentials.
# Server-only OpenAI project key. Set a provider budget/alerts as well.
OPENAI_API_KEY=replace-with-your-openai-project-key

# Optional browser origin allowlist. Native Rust requests do not send an Origin.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase into Edge Functions. Do not put service-role credentials in PRO.
