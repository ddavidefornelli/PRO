# Optional, SERVER-SIDE weekly AI configuration.
# Copy to supabase/.env.local. Never put these values in the root .env or build args.
# Leave empty for local development without paid provider calls; global AI stays off.
OPENAI_API_KEY=
# Optional comma-separated browser origins. Native clients have no Origin header.
# Overrides the defaults when set; include every origin you need.
# ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420,https://www.prune.win,https://localhost:5173
